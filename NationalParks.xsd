<?xml version="1.0"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema"
	targetNamespace="https://www.nationalparks.assignmentfour.org/xml"
	xmlns:np="https://www.nationalparks.assignmentfour.org/xml"
	elementFormDefault="qualified" attributeFormDefault="unqualified">
<element name="NationalPark">
	<complexType>
		<sequence>
			<element name="Name" type="string"/>
			<element name="Phone" type="string" minOccurs="1" maxOccurs="unbounded"/>
			<element name="Address">
				<complexType>
					<sequence>
						<element name="Number" type="string"/>
						<element name="Street" type="string"/>
						<element name="City" type="string"/>
						<element name="State" type="string"/>
						<element name="Zip" type="string"/>
					</sequence>
					<attribute name="NearestAirport" type="string" use="required"/>
				</complexType>
			</element>
		</sequence>
		<attribute name="Rating" type="float" use="optional"/>
	</complexType>
</element>
<element name="NationalParks">
	<complexType>
		<sequence>
			<element ref="np:NationalPark" minOccurs="1" maxOccurs="unbounded"/>
		</sequence>
	</complexType>
</element>
</schema>
